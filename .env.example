# Copiá este archivo como .env y completá los valores. NO subas el .env a ningún repositorio.
# (Para producción con Docker usá .env.produccion.example)

# Clave larga y aleatoria:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Mercado Pago -> Tus integraciones -> tu aplicación
# Para el piloto usá las credenciales de PRUEBA (vendedor de prueba). Empiezan con APP_USR-
MP_ACCESS_TOKEN=
# Webhooks -> Configurar notificaciones -> "Clave secreta" que genera Mercado Pago
MP_WEBHOOK_SECRET=

# URL pública HTTPS de la web (ngrok hoy, tu dominio mañana). Mercado Pago vuelve acá después de pagar.
PUBLIC_URL=https://TU-SUBDOMINIO.ngrok-free.dev

# --- Mails (ver docs/MAILS.md) ---
# Sin MAIL_USERNAME los mails NO se envían: se imprimen en la consola (modo desarrollo).
# Con Gmail, MAIL_PASSWORD tiene que ser una "contraseña de aplicación".
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=ENID <tu-correo@gmail.com>
# CONTACT_EMAIL=          # "responder a" de los mails y destino de los avisos para el dueño

# --- Opcionales ---
# CRON_TOKEN=             # para disparar los recordatorios por HTTP desde un cron externo
# DATABASE_URL=           # por defecto SQLite local (instance/pagos.db); en producción, PostgreSQL
# SECURE_COOKIES=1        # cookies solo-https (se activan solas con un PUBLIC_URL https que no sea ngrok)
# TRUST_PROXY=1           # detrás de un proxy (Caddy, Nginx, Render...)
# FLASK_DEBUG=1           # solo en desarrollo
