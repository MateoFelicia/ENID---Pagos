# ===== ENID en producción (docker compose) =====
# Copiá este archivo como .env, completalo y NO lo subas a ningún repositorio.

# --- Tu dominio ---
DOMINIO=cursos.tudominio.com.ar
PUBLIC_URL=https://cursos.tudominio.com.ar

# --- Seguridad ---
# Generá una:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Contraseña de la base de datos (inventá una larga; sin símbolos raros)
POSTGRES_PASSWORD=

# --- Mercado Pago: credenciales PRODUCTIVAS (Tus integraciones → Credenciales de producción) ---
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Webhooks → pestaña de producción)
MP_WEBHOOK_SECRET=

# --- Mails (ver docs/MAILS.md) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=ENID <tu-correo@gmail.com>
CONTACT_EMAIL=

# --- Opcionales ---
# Para disparar los recordatorios desde un cron externo (POST /tareas/recordatorios con este token)
# CRON_TOKEN=
# Gunicorn: 1 proceso con 8 hilos alcanza de sobra para empezar.
# Si subís WEB_CONCURRENCY, definí también RATELIMIT_STORAGE_URI (Redis) para que el límite
# de intentos de inicio de sesión se comparta entre procesos.
# WEB_CONCURRENCY=1
# WEB_THREADS=8
# RATELIMIT_STORAGE_URI=redis://...
